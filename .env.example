# Required. Vercel → Project → Settings → Environment Variables.
# Used by /api/elevenlabs-token to write the intake prompt + Focus/Manipulation
# guardrails onto the ElevenLabs agent. Without it, the widget uses the generic
# dashboard prompt and will talk about general topics.
ELEVENLABS_API_KEY=

# Optional override. Defaults to Intake Monkyfi.
# ELEVENLABS_AGENT_ID=agent_8801m05ndkpyfanva562vsc3ss9j
