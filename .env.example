# Required for Intake Monkyfi guardrails. When set, /api/elevenlabs-token
# writes the intake prompt onto the ElevenLabs agent and issues a signed URL.
# Without this key the public widget still runs, but with the dashboard prompt only.
ELEVENLABS_API_KEY=

# Optional override. Defaults to Intake Monkyfi.
# ELEVENLABS_AGENT_ID=agent_8801m05ndkpyfanva562vsc3ss9j
