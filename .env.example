# Optional. When set, /api/elevenlabs-token issues a signed conversation URL
# for Intake Monkyfi and syncs the intake prompt to the ElevenLabs agent.
# If unset, the public agent-id widget embed is used (prompt is still applied
# client-side via override-prompt).
ELEVENLABS_API_KEY=

